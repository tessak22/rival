# Required
TABSTACK_API_KEY=
DATABASE_URL=

# Notifications
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# Config
DEMO_RATE_LIMIT=3
CRON_SECRET=
# Local dev: skip DB writes for demo scanning (rate limit and lock not enforced)
DEMO_SKIP_PERSISTENCE=
INTERNAL_API_KEY=
MANUAL_STALE_DAYS=30
# Which competitor config this instance reads (default rivals.config.json). One instance = one product;
# a second product needs its own deployment and its own DATABASE_URL, e.g. rivals.config.ichabod.json.
# Traced builds (Netlify, Vercel, standalone) bundle only rivals.config*.json from the repo root;
# other relative paths fail there. An absolute path to a file on the host still loads.
RIVAL_CONFIG_PATH=

# Quiver integration (optional) — push nightly competitor reports to Quiver research layer
QUIVER_MCP_URL=
QUIVER_MCP_SECRET=
