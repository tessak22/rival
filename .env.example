# Required
TABSTACK_API_KEY=
DATABASE_URL=

# Notifications
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# Config
DEMO_RATE_LIMIT=3
CRON_SECRET=
# Local dev: skip DB writes for demo scanning (rate limit and lock not enforced)
DEMO_SKIP_PERSISTENCE=
# Local-only fixture mode: runs the /demo flow without Postgres or Tabstack.
# Results are explicitly labeled offline fixtures and are not live intelligence.
RIVAL_OFFLINE_DEMO=false
INTERNAL_API_KEY=
MANUAL_STALE_DAYS=30

# Quiver integration (optional) — push nightly competitor reports to Quiver research layer
QUIVER_MCP_URL=
QUIVER_MCP_SECRET=
